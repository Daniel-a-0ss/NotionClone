{
  "name": "notion-clone",
  "version": "0.1.0",
  "description": "Aplicación de escritorio tipo Notion - MVP (Electron + React + TypeScript)",
  "main": "dist/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"webpack --mode development --watch\" \"wait-on dist/index.html && electron .\"",
  "build": "webpack --mode production && electron-builder",
  "build:web": "webpack --mode production",
  "vercel-build": "npm run build:web",
    "start": "electron .",
    "test": "jest --passWithNoTests"
  },
  "build": {
    "appId": "com.example.notionclone",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "@tiptap/react": "^2.0.0-beta.83",
    "@tiptap/starter-kit": "^2.0.0-beta.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "acorn": "^8.15.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "electron": "^25.0.0",
    "electron-builder": "^26.7.0",
    "eslint": "^8.48.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "prettier": "^3.1.2",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.1.6",
    "wait-on": "^7.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
